<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.brain.heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/brain-tools/.venv/bin/brain</string>
    <string>heartbeat</string>
    <string>--commit</string>
    <!-- Optional reflect step (proposes changes; never edits raw/ or memory/core.md).
         Remove these two lines for the deterministic heartbeat only. Give it no network tools. -->
    <string>--llm</string>
    <string>claude -p --allowedTools Read,Edit,Write</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/brain-vault</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAIN_VAULT</key><string>/ABSOLUTE/PATH/brain-vault</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/tmp/brain-heartbeat.log</string>
  <key>StandardErrorPath</key><string>/tmp/brain-heartbeat.log</string>
</dict>
</plist>
